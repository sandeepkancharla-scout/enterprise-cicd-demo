name: Deployment Pipeline

on:
  workflow_dispatch:

    inputs:

      environment:

        description: "Select Environment"

        required: true

        type: choice

        options:
          - dev
          - staging
          - prod

jobs:

  deploy:

    runs-on: ubuntu-latest

    environment:
      name: ${{ inputs.environment }}

    steps:

      - name: Checkout Code
        uses: actions/checkout@v4

      - name: Show Deployment Information

        run: |
          echo "Environment: ${{ inputs.environment }}"
          echo "Application URL: ${{ vars.APP_URL }}"

      - name: Create Deployment Report

        run: |
          mkdir reports

          echo "Deployment Pipeline" > reports/deployment-report.txt
          echo "Environment: ${{ inputs.environment }}" >> reports/deployment-report.txt
          echo "Application URL: ${{ vars.APP_URL }}" >> reports/deployment-report.txt
          echo "Commit: ${{ github.sha }}" >> reports/deployment-report.txt
          echo "Triggered By: ${{ github.actor }}" >> reports/deployment-report.txt

      - name: Upload Deployment Report

        uses: actions/upload-artifact@v4

        with:
          name: deployment-report-${{ inputs.environment }}

          path: reports/deployment-report.txt